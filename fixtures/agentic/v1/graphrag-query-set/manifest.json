          "graph_hop": 0
        },
        {
          "chunk_id": "noise_evidence_preflight",
          "chunk_kind": "evidence_excerpt",
          "lifecycle_status": "active",
          "text": "EvidenceArtifact kind=session media_type=application/json artifact_id=art_preflight event_id=evt_noise_preflight",
          "graph_hop": 1
        },
        {
          "chunk_id": "noise_tool_status",
          "chunk_kind": "evidence_excerpt",
          "lifecycle_status": "active",
          "text": "EvidenceArtifact kind=tool media_type=text/plain artifact_id=art_git preflight git status exit 0",
          "graph_hop": 2
