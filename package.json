{
  "name": "@carpeos/root",
  "version": "0.0.0",
  "private": true,
  "description": "Public monorepo for CarpeOS, a personal knowledge operating system for AI-assisted work.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11.16.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm public-boundary && pnpm labels:check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "labels:check": "node scripts/check-label-catalog.mjs && node --test scripts/check-pr-labels.test.mjs",
    "public-boundary": "node scripts/check-public-boundary.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.18.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
