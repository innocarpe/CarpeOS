{
  "name": "@carpeos/root",
  "version": "0.0.0",
  "private": true,
  "description": "Public monorepo for CarpeOS — personal knowledge OS for AI-assisted work (capture, accepted decisions, MCP/CLI/Obsidian, local-first).",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11.16.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm public-boundary",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "public-boundary": "node scripts/check-public-boundary.mjs",
    "test": "pnpm -r --if-present test && node --test scripts/test/*.test.mjs packages/carpeos/test/*.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:product": "node scripts/smoke-product-loop.mjs",
    "smoke:knowledge": "node scripts/smoke-knowledge.mjs",
    "smoke:dogfood": "node scripts/smoke-dogfood.mjs",
    "install:local": "node scripts/install-local.mjs",
    "pack:npm": "pnpm --filter @innocarpe/carpeos build && pnpm --filter @innocarpe/carpeos exec npm pack --pack-destination ../..",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs patch --dry-run",
    "g1:recheck": "node scripts/g1-recheck.mjs",
    "preflight": "node scripts/preflight.mjs",
    "preflight:quick": "node scripts/preflight.mjs --mode=quick",
    "preflight:pr": "node scripts/preflight.mjs --mode=pr",
    "preflight:full": "node scripts/preflight.mjs --mode=full"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.18.6",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
