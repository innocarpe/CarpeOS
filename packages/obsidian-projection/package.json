{
  "name": "@carpeos/obsidian-projection",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic non-authoritative Obsidian projection for CarpeOS retrieval state.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
