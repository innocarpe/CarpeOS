    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@carpeos/local-store": "workspace:*",
    "@carpeos/retrieval": "workspace:*",
    "@carpeos/schema": "workspace:*"
  }
}
