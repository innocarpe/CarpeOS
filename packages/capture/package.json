{
  "name": "@carpeos/capture",
  "version": "0.0.0",
  "private": true,
  "description": "Provider-neutral capture envelopes and canonical event construction.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "eval:adjudication": "pnpm build && node dist/adjudication-evaluation.js test/fixtures/adjudication-quality-v1.json",
    "eval:knowledge-form": "pnpm build && node dist/knowledge-form-evaluation.js test/fixtures/knowledge-form-support-v1.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@carpeos/schema": "workspace:*"
  }
}
