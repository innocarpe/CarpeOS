  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innocarpe/carpeos.git",
    "directory": "packages/carpeos"
  },
  "homepage": "https://github.com/innocarpe/carpeos#readme",
  "bugs": {
    "url": "https://github.com/innocarpe/carpeos/issues"
  },
  "keywords": [
    "carpeos",
    "mcp",
    "cli",
    "memory",
    "agents",
    "knowledge"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepack": "node ./scripts/build.mjs",
    "typecheck": "node -e \"process.exit(0)\"",
    "test": "node --test ./test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
