{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "carpeos capture-hook --provider grok --fail-open --quiet",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "carpeos capture-hook --provider grok --fail-open --quiet",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "carpeos capture-hook --provider grok --fail-open --quiet",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "carpeos capture-hook --provider grok --fail-open --quiet",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "carpeos capture-hook --provider grok --fail-open --quiet",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "carpeos capture-hook --provider grok --fail-open --quiet",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
