{
  "description": "Capture selected Codex lifecycle events into the local CarpeOS outbox.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "carpeos capture-hook --provider codex --fail-open --quiet",
            "timeout": 5,
            "statusMessage": "Capturing session start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "carpeos capture-hook --provider codex --fail-open --quiet",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "carpeos capture-hook --provider codex --fail-open --quiet",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "carpeos capture-hook --provider codex --fail-open --quiet",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "carpeos capture-hook --provider codex --fail-open --quiet",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "carpeos capture-hook --provider codex --fail-open --quiet",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
